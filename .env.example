# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional model overrides
GEMINI_MODEL_TRIAGE=gemini-2.5-flash
GEMINI_MODEL_BODY=gemini-2.5-flash-lite

# Analytics (optional) — see docs/analytics.md
# Cloudflare Web Analytics beacon token. When set, `bun run generate` emits a
# cookieless, privacy-friendly analytics beacon on every page. Unset = no script.
CF_BEACON_TOKEN=

# Newsletter signup (optional). Public form identifiers for the third-party
# provider (MailerLite) the browser POSTs to — not secrets. When
# NEWSLETTER_FORM_ACTION is set, `bun run generate` renders the signup box;
# unset = the box is omitted and the build still succeeds.
#   NEWSLETTER_FORM_ACTION   provider form endpoint the browser POSTs to
#   NEWSLETTER_EMAIL_FIELD   name of the email field (defaults to "email")
#   NEWSLETTER_HIDDEN_FIELDS JSON map of hidden inputs (list id, etc.)
NEWSLETTER_FORM_ACTION=
NEWSLETTER_EMAIL_FIELD=
NEWSLETTER_HIDDEN_FIELDS=

# For scripts/analytics-report.ts (weekly traffic baseline). In CI these come
# from repo secrets; set locally only if you want to run the report by hand.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Saturday Special newsletter (scripts/send-newsletter.ts). The digest sends only
# when all four are set; otherwise the script builds and prints but does not send.
#   MAILERLITE_API_KEY     account API key (secret)
#   MAILERLITE_GROUP_ID    subscriber group the digest is sent to
#   MAILERLITE_FROM_NAME   verified sender name
#   MAILERLITE_FROM_EMAIL  verified sender email
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
MAILERLITE_FROM_NAME=
MAILERLITE_FROM_EMAIL=
# Optional: override the Saturday date / force a re-send when running by hand.
# NEWSLETTER_DATE=2026-07-18
# FORCE_SEND=1
