# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional model overrides
GEMINI_MODEL_TRIAGE=gemini-2.5-flash
GEMINI_MODEL_BODY=gemini-2.5-flash-lite

# Analytics (optional) — see docs/analytics.md
# Cloudflare Web Analytics beacon token. When set, `bun run generate` emits a
# cookieless, privacy-friendly analytics beacon on every page. Unset = no script.
CF_BEACON_TOKEN=

# For scripts/analytics-report.ts (weekly traffic baseline). In CI these come
# from repo secrets; set locally only if you want to run the report by hand.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
